{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "main.py" },
    { "src": "/static/(.*)", "dest": "/frontend/$1" },
    { "src": "/(.*\\.html)", "dest": "/frontend/$1" },
    { "src": "/css/(.*)", "dest": "/frontend/css/$1" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/victim", "dest": "/frontend/victim.html" },
    { "src": "/officer", "dest": "/frontend/officer.html" },
    { "src": "/admin", "dest": "/frontend/admin.html" },
    { "src": "/", "dest": "/frontend/landing.html" },
    { "src": "/(.*)", "dest": "main.py" }
  ]
}
